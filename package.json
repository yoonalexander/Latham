{
  "name": "latham",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Independent voice-controlled computer assistant — voice/provider and Chrome setup",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-host.mjs",
    "start": "node scripts/start.mjs",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run setup:electron && playwright test",
    "evaluate": "npm run typecheck && npm test && npm run test:e2e",
    "check": "npm run typecheck && npm test && npm run build",
    "setup:electron": "node node_modules/electron/install.js",
    "setup:browser": "playwright install chromium && node scripts/setup-browser.mjs",
    "test:providers": "node scripts/evaluate-providers.mjs --model=qwen2.5:1.5b"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "main": "dist/main.cjs"
}
