{
  "manifest_version": 3,
  "name": "Latham",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "description": "Connect Chrome to Latham. Site access is optional and starts paused.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "scripting"],
  "optional_host_permissions": ["https://www.google.com/*", "https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Latham",
    "default_popup": "popup.html"
  }
}
